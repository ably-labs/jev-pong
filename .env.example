# Vercel AI Gateway key (create at vercel.com → team → AI Gateway → API keys; set a budget).
# On Vercel deployments OIDC is used automatically; locally `vercel env pull` also provides VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Ably API key for the demo app. Server-side only; browsers get short-lived tokens from /api/ably-token.
ABLY_API_KEY=
